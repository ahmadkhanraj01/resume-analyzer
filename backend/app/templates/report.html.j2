<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <style>{{ css }}</style>
</head>
<body>
  <h1>{{ title }}</h1>
  <div class="score-label">Match score</div>
  <div class="score">{{ match_score }}%</div>
  {% if scored_against == "role_profile" %}
  <p class="note">Scored against a typical {{ role_title or "role" }} profile, not a specific job posting.</p>
  {% endif %}

  <h2>Skill gaps</h2>
  {% for gap in skill_gaps %}
  <div class="skill-gap">
    <span class="severity-{{ gap.severity }}">{{ gap.severity | upper }}</span>
    &mdash; <strong>{{ gap.skill }}</strong>
    <div>{{ gap.advice }}</div>
  </div>
  {% endfor %}

  <h2>Technical questions</h2>
  {% for q in technical_qs %}
  <div class="question">
    <div><strong>{{ loop.index }}. {{ q.question }}</strong></div>
    <div class="intention">Probing: {{ q.intention }}</div>
    <div class="answer">{{ q.answer }}</div>
  </div>
  {% endfor %}

  <h2>Behavioral questions</h2>
  {% for q in behavioral_qs %}
  <div class="question">
    <div><strong>{{ loop.index }}. {{ q.question }}</strong></div>
    <div class="intention">Probing: {{ q.intention }}</div>
    <div class="answer">{{ q.answer }}</div>
  </div>
  {% endfor %}

  <h2>Preparation plan</h2>
  {% for day in preparation_plan %}
  <div class="prep-day">
    <div class="focus">Day {{ day.day }}: {{ day.focus }}</div>
    <ul>
      {% for task in day.tasks %}
      <li>{{ task }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}

  <footer>Generated by Resume Analyzer &middot; {{ created_at }}</footer>
</body>
</html>
