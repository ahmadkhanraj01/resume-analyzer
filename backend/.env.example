# Database (pooled connection string from Supabase or Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth
JWT_SECRET=  # at least 32 bytes; `openssl rand -hex 32`
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# CORS: comma-separated list of allowed origins, no wildcard
CORS_ORIGINS=http://localhost:5173

# Scoring thresholds
COVERED_THRESHOLD=0.75
PARTIAL_THRESHOLD=0.55

# Rate limits
ANALYSES_PER_HOUR=10
ANALYSES_PER_DAY=30
AUTH_ATTEMPTS_PER_HOUR=20
MAX_REPORTS_PER_USER=50
